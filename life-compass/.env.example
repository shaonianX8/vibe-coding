# Life Compass 环境变量示例。复制为 .env.local（本地）或填到 Vercel 的 Environment Variables（线上）。
# 所有变量只在服务器端使用，不要加 NEXT_PUBLIC_ 前缀，不要提交真实值到仓库。

# Supabase 项目（Project Settings → API Keys）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 仅供云端定时提醒使用，绕过行级安全，务必保密
SUPABASE_SECRET_KEY=sb_secret_xxx

# 允许登录的邮箱（逗号分隔）。为空时任何人都无法登录。
ALLOWED_EMAILS=you@example.com

# 定时任务调用 /api/cron/tick 时携带的密钥。用 openssl rand -hex 32 生成。
CRON_SECRET=change-me-to-a-long-random-string

# Web Push（运行 npm run vapid 生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 推送服务联系方式，mailto: 加你的邮箱
VAPID_SUBJECT=mailto:you@example.com

# AI（可选）。不填时所有基础功能照常使用，只是没有 AI 细化建议。
ANTHROPIC_API_KEY=
# 默认 claude-opus-5-5，可替换
AI_MODEL=claude-opus-5-5
# 24 小时内最多 AI 调用次数，用于控制成本
AI_DAILY_LIMIT=20
